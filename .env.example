# ─── Groq LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# The same database the Node backend writes, so the agents read real records
# rather than a second copy that drifts. A +srv URI with no database path
# lands on "test", which is where the seeded data lives.
MONGODB_URI=
MONGODB_DB=test
MONGODB_TIMEOUT_MS=8000

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Hospital Multi-Agent System
APP_ENV=development
HOSPITAL_TIMEZONE=Asia/Kolkata
